# ──────────────────────────────────────────────
# bot-as-shell — Environment Configuration
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#   chmod 600 .env

# Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram user ID (the only user allowed to send commands)
ALLOWED_CHAT_ID=your_numeric_chat_id

# ── Optional overrides ───────────────────────

# Working directory for opencode commands (default: current directory)
# WORKDIR=/path/to/workspace

# Path to opencode binary (default: discovered via PATH)
# OPENCODE_BIN=/usr/local/bin/opencode

# Log directory (default: ./logs)
# LOG_DIR=/var/log/bot-as-shell

# Process timeout in seconds (default: 600)
# PROCESS_TIMEOUT=600
