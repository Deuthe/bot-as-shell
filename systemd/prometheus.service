[Unit]
Description=Prometheus Metrics Server
After=network.target

[Service]
Type=simple
User={{USER}}
ExecStart=/usr/local/bin/prometheus \
  --config.file={{DIR}}/monitoring/prometheus/prometheus.yml \
  --storage.tsdb.path={{DIR}}/monitoring/prometheus/data \
  --web.listen-address=127.0.0.1:9090
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
