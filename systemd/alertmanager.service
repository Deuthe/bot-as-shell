[Unit]
Description=Alertmanager
After=network.target

[Service]
Type=simple
User={{USER}}
ExecStart=/usr/local/bin/alertmanager \
  --config.file={{DIR}}/monitoring/alertmanager/alertmanager.yml \
  --storage.path={{DIR}}/monitoring/alertmanager/data \
  --web.listen-address=127.0.0.1:9093
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
